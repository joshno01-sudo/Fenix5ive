{
  "_comment": "ComfyUI API-format workflow. SDXL checkpoint + a Bruce Timm / DCAU style LoRA + Canny ControlNet fed by one of the line guides in ../comfyui/guides. Load it in the ComfyUI web UI (Workflow > Open, API JSON is accepted) or POST it to /prompt with queue_prompts.py, which fills in the prompt, seed and guide image per character.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "timm_dcau_style_sdxl.safetensors",
      "strength_model": 0.85,
      "strength_clip": 0.85
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 1],
      "text": "POSITIVE PROMPT FILLED IN PER CHARACTER"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 1],
      "text": "photorealistic, 3d render, anime, manga, sketch, pencil, watercolor, painterly, soft shading, gradient shading, skin texture, blurry, lowres, extra fingers, deformed hands, text, watermark, signature, multiple views, cropped"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {"image": "jake-head.png", "upload": "image"}
  },
  "6": {
    "class_type": "Canny",
    "inputs": {"image": ["5", 0], "low_threshold": 0.2, "high_threshold": 0.6}
  },
  "7": {
    "class_type": "ControlNetLoader",
    "inputs": {"control_net_name": "controlnet-canny-sdxl-1.0.safetensors"}
  },
  "8": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["3", 0],
      "negative": ["4", 0],
      "control_net": ["7", 0],
      "image": ["6", 0],
      "strength": 0.55,
      "start_percent": 0.0,
      "end_percent": 0.7
    }
  },
  "9": {
    "class_type": "EmptyLatentImage",
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["9", 0],
      "seed": 20260904,
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["10", 0], "vae": ["1", 2]}
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {"images": ["11", 0], "filename_prefix": "animorphs_timm/jake"}
  }
}
