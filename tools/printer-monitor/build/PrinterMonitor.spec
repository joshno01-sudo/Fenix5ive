# PyInstaller spec for the Printer Supply Monitor. Build with:
#
#     pyinstaller build/PrinterMonitor.spec --noconfirm --clean
#
# Produces dist/PrinterMonitor/ holding two programs that share one copy of
# Python and the libraries:
#
#     PrinterMonitor.exe    windowed  - what you double-click
#     printer-monitor.exe   console   - the command line, for Task Scheduler
#
# Two executables rather than one because the tool genuinely has both faces. A
# windowed build has nowhere to print, so `check` and `scan` would come back
# silent; a console build flashes a black window every time somebody opens the
# monitor. One shared folder costs a few hundred KB over a single exe and
# starts faster than a self-extracting one.

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(SPEC)))
BUILD = os.path.join(ROOT, "build")
ICON = os.path.join(BUILD, "printermonitor.ico")

sys.path.insert(0, ROOT)
from printer_monitor.version import APP_NAME, PUBLISHER, VERSION  # noqa: E402


def _write_version_info(exe_name: str) -> str:
    """Generate the Windows version resource from version.py.

    Generated rather than committed so the number in the file properties can
    never drift from the number the program reports. One per executable, so
    each reports its own filename rather than both claiming to be the other.
    """
    parts = [int(piece) for piece in VERSION.split(".")]
    while len(parts) < 4:
        parts.append(0)
    quad = ", ".join(str(piece) for piece in parts[:4])
    text = f"""# Generated by PrinterMonitor.spec from printer_monitor/version.py.
VSVersionInfo(
  ffi=FixedFileInfo(
    filevers=({quad}),
    prodvers=({quad}),
    mask=0x3f,
    flags=0x0,
    OS=0x40004,
    fileType=0x1,
    subtype=0x0,
    date=(0, 0)
  ),
  kids=[
    StringFileInfo([
      StringTable(
        '040904B0',
        [StringStruct('CompanyName', '{PUBLISHER}'),
         StringStruct('FileDescription', '{APP_NAME} - printer supply levels and spare stock'),
         StringStruct('FileVersion', '{VERSION}'),
         StringStruct('InternalName', '{exe_name}'),
         StringStruct('OriginalFilename', '{exe_name}.exe'),
         StringStruct('ProductName', '{APP_NAME}'),
         StringStruct('ProductVersion', '{VERSION}')])
    ]),
    VarFileInfo([VarStruct('Translation', [1033, 1200])])
  ]
)
"""
    path = os.path.join(BUILD, f"version_info_{exe_name}.txt")
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(text)
    return path


GUI_VERSION_INFO = _write_version_info("PrinterMonitor")
CLI_VERSION_INFO = _write_version_info("printer-monitor")

# The GUI is imported inside functions so the command line never needs a
# display; name the modules so they are packaged all the same.
HIDDEN = [
    "printer_monitor.gui",
    "printer_monitor.gui.app",
    "printer_monitor.gui.dashboard",
    "printer_monitor.gui.popup",
    "printer_monitor.gui.settings",
    "printer_monitor.gui.supplies",
    "tkinter",
    "tkinter.ttk",
    "tkinter.filedialog",
    "tkinter.messagebox",
    "tkinter.simpledialog",
]

# Third-party packages only. Excluding stdlib modules saves little and risks a
# bundle that builds fine here and then fails on the shop PC.
EXCLUDES = [
    "numpy", "PIL", "matplotlib", "scipy", "pandas",
    "pytest", "setuptools", "pip", "PyInstaller",
]

COMMON = dict(
    pathex=[ROOT],
    binaries=[],
    datas=[],
    hookspath=[],
    runtime_hooks=[],
    excludes=EXCLUDES,
    noarchive=False,
)

gui_analysis = Analysis([os.path.join(ROOT, "PrinterMonitor.py")], hiddenimports=HIDDEN, **COMMON)
cli_analysis = Analysis([os.path.join(ROOT, "printer-monitor.py")], hiddenimports=HIDDEN, **COMMON)

gui_pyz = PYZ(gui_analysis.pure)
cli_pyz = PYZ(cli_analysis.pure)

gui_exe = EXE(
    gui_pyz,
    gui_analysis.scripts,
    [],
    exclude_binaries=True,      # the libraries live in the folder, shared
    name="PrinterMonitor",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,                  # UPX-packed exes trip antivirus heuristics
    console=False,              # a window, not a terminal
    disable_windowed_traceback=False,
    icon=ICON if os.path.isfile(ICON) else None,
    version=GUI_VERSION_INFO,
)

cli_exe = EXE(
    cli_pyz,
    cli_analysis.scripts,
    [],
    exclude_binaries=True,
    name="printer-monitor",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=True,               # prints where you can read it
    disable_windowed_traceback=False,
    icon=ICON if os.path.isfile(ICON) else None,
    version=CLI_VERSION_INFO,
)

coll = COLLECT(
    gui_exe,
    gui_analysis.binaries,
    gui_analysis.datas,
    cli_exe,
    cli_analysis.binaries,
    cli_analysis.datas,
    strip=False,
    upx=False,
    name="PrinterMonitor",
)
